                            {{#if system.toggles.innateMagicVis}}
                            <span> {{localize "abfalter.settingsTab.hidden"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.notHidden"}} </span>
                            {{/if}}
                        </button>
                    </label>
                    <label class="setSingleInput {{#if system.toggles.magicTab}}hidden{{/if}}">
                        <span> {{localize "abfalter.settingsTab.spellcasting"}} </span>
                        <button type="button" data-action="toggleValue"
                            class="toggleBoolean {{#if system.toggles.spellcastingVis}}kiBought{{/if}}"
                            data-label="system.toggles.spellcastingVis" data-ability="{{system.toggles.spellcastingVis}}">
