                            class="toggleBoolean {{#if system.toggles.magicTheoryVis}}kiBought{{/if}}"
                            data-label="system.toggles.magicTheoryVis" data-ability="{{system.toggles.magicTheoryVis}}">
                            {{#if system.toggles.magicTheoryVis}}
                            <span> {{localize "abfalter.settingsTab.hidden"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.notHidden"}} </span>
                            {{/if}}
                        </button>
                    </label>
                    <label class="setSingleInput {{#if system.toggles.magicTab}}hidden{{/if}}">
                        <span> {{localize "abfalter.settingsTab.innateMagic"}} </span>
                        <button type="button" data-action="toggleValue"
