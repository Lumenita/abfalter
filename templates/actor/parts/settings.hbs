<section class="tab {{tabs.settings.cssClass}} actorPage settingsPage baseAbfalterV2" data-group="{{tabs.settings.group}}" data-tab="{{tabs.settings.id}}">
    <div class="fieldsetContainerRowV2">
        <div class="fieldSetColumnV2 settingsOptions">
            <fieldset>
                <legend> {{localize "abfalter.settingsTab.generalSettings"}} </legend>
                <div class="settingsSubsection abfDivFormat">
                    <label>
                        <span> {{localize "abfalter.settingsTab.hideCurrency"}} </span>
                        <button type="button" data-action="toggleValue"
                            class="toggleBoolean {{#if system.toggles.currencyHide}}kiBought{{/if}}"
                            data-label="system.toggles.currencyHide" data-ability="{{system.toggles.currencyHide}}">
                            {{#if system.toggles.currencyHide}}
                            <span> {{localize "abfalter.settingsTab.active"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.notActive"}} </span>
                            {{/if}}
                        </button>
                    </label>

                    <label>
                        <span> {{localize "abfalter.openDpCalc"}} </span>
                        <button type="button" data-action="openDPCalc">
                            <span> {{localize "abfalter.settingsTab.open"}} </span>
                        </button>
                    </label>

                    <label>
                        <span> {{localize "abfalter.settingsTab.changeTemp"}} </span>
                        <button type="button" data-action="configButton" data-ability="changeSecTemp">
                            <span> {{localize "abfalter.settingsTab.open"}} </span>
                        </button>
                    </label>

                    <label>
                        <span> {{localize "abfalter.settingsTab.changeSpec"}} </span>
                        <button type="button" data-action="configButton" data-ability="changeSecSpec">
                            <span> {{localize "abfalter.settingsTab.open"}} </span>
                        </button>
                    </label>

                    <label>
                        <span> {{localize "abfalter.isMass"}} </span>
                        <button type="button" data-action="toggleValue"
                            class="toggleBoolean {{#if system.isMass.isMass}}kiBought{{/if}}"
                            data-label="system.isMass.isMass" data-ability="{{system.isMass.isMass}}">
                            {{#if system.isMass.isMass}}
                            <span> {{localize "abfalter.settingsTab.active"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.notActive"}} </span>
                            {{/if}}
                        </button>
                    </label>
                </div>
            </fieldset>

            <fieldset>
                <legend> {{localize "abfalter.settingsTab.moduleSettings"}} </legend>               
                <div class="settingsSubsection abfDivFormat">
                    <label>
                        <span> {{localize "abfalter.settingsTab.magicAttackModule"}} </span>
                        <button type="button" data-action="toggleValue"
                            class="toggleBoolean {{#if system.toggles.magicAtkModule}}kiBought{{/if}}"
                            data-label="system.toggles.magicAtkModule" data-ability="{{system.toggles.magicAtkModule}}">
                            {{#if system.toggles.magicAtkModule}}
                            <span> {{localize "abfalter.settingsTab.active"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.notActive"}} </span>
                            {{/if}}
                        </button>
                    </label>
                    <label class="{{#if system.toggles.magicDodgeModule}}lockLabel{{/if}}">
                        <span> {{localize "abfalter.settingsTab.magicDefenseModule"}} </span>
                        <button type="button" data-action="toggleValue"
                            class="toggleBoolean {{#if system.toggles.magicDefModule}}kiBought{{/if}}"
                            data-label="system.toggles.magicDefModule" data-ability="{{system.toggles.magicDefModule}}">
                            {{#if system.toggles.magicDefModule}}
                            <span> {{localize "abfalter.settingsTab.active"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.notActive"}} </span>
                            {{/if}}
                        </button>
                    </label>
                    {{#if system.toggles.magicDefModule}}
                    <label>
                        <span class="settingsSubsectionIndent"> {{localize "abfalter.settingsTab.magicDodgeModule"}}</span>
                        <button type="button" data-action="toggleValue"
                            class="toggleBoolean {{#if system.toggles.magicDodgeModule}}kiBought{{/if}}"
                            data-label="system.toggles.magicDodgeModule" data-ability="{{system.toggles.magicDodgeModule}}">
                            {{#if system.toggles.magicDodgeModule}}
                            <span> {{localize "abfalter.settingsTab.active"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.notActive"}} </span>
                            {{/if}}
                        </button>
                    </label>
                    {{/if}}
                    <label class="{{#if system.toggles.psychicDodgeStatus}}lockLabel{{/if}}">
                        <span> {{localize "abfalter.settingsTab.psyAttackModule"}} </span>
                        <button type="button" data-action="toggleValue"
                            class="toggleBoolean {{#if system.toggles.psychicModuleStatus}}kiBought{{/if}}"
                            data-label="system.toggles.psychicModuleStatus"
                            data-ability="{{system.toggles.psychicModuleStatus}}">
                            {{#if system.toggles.psychicModuleStatus}}
                            <span> {{localize "abfalter.settingsTab.active"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.notActive"}} </span>
                            {{/if}}
                        </button>
                    </label>
                    {{#if system.toggles.psychicModuleStatus}}
                    <label>
                        <span class="settingsSubsectionIndent"> {{localize "abfalter.settingsTab.magicDodgeModule"}} </span>
                        <button type="button" data-action="toggleValue"
                            class="toggleBoolean {{#if system.toggles.psychicDodgeStatus}}kiBought{{/if}}"
                            data-label="system.toggles.psychicDodgeStatus"
                            data-ability="{{system.toggles.psychicDodgeStatus}}">
                            {{#if system.toggles.psychicDodgeStatus}}
                            <span> {{localize "abfalter.settingsTab.active"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.notActive"}} </span>
                            {{/if}}
                        </button>
                    </label>
                    {{/if}}
                </div>
            </fieldset>

            <fieldset>
                <legend> {{localize "abfalter.settingsTab.kiSettings"}} </legend>
                <div class="settingsSubsection abfDivFormat">
                    <label class="{{#if system.toggles.innatePower}}lockLabel{{/if}}">
                        <span> {{localize "abfalter.settingsTab.unifiedKi"}} </span>
                        <button type="button" data-action="toggleValue"
                            class="toggleBoolean {{#if system.toggles.unifiedPools}}kiBought{{/if}}"
                            data-label="system.toggles.unifiedPools" data-ability="{{system.toggles.unifiedPools}}">
                            {{#if system.toggles.unifiedPools}}
                            <span> {{localize "abfalter.settingsTab.active"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.notActive"}} </span>
                            {{/if}}
                        </button>
                    </label>
                    {{#if system.toggles.unifiedPools}}
                    <label>
                        <span class="settingsSubsectionIndent"> {{localize "abfalter.settingsTab.innatePower"}} </span>
                        <button type="button" data-action="toggleValue"
                            class="toggleBoolean {{#if system.toggles.innatePower}}kiBought{{/if}}"
                            data-label="system.toggles.innatePower" data-ability="{{system.toggles.innatePower}}">
                            {{#if system.toggles.innatePower}}
                            <span> {{localize "abfalter.settingsTab.active"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.notActive"}} </span>
                            {{/if}}
                        </button>
                    </label>
                    {{/if}}
                    {{#if system.toggles.innatePower}}
                    <label class="innatePowerSetting">
                        <span class="settingsSubsectionIndent"> {{localize "abfalter.settingsTab.innateType"}} </span>
                        <div class="csSelect">
                            <label>
                                <select name="system.kiPool.innate.type">
                                    {{selectOptions InnatePowerObjList selected=system.kiPool.innate.type localize=true}}
                                </select>
                            </label>
                        </div>
                    </label>
                    {{/if}}
                    <label>
                        <span> {{localize "abfalter.settingsTab.dragonSeals"}} </span>
                        <button type="button" data-action="toggleValue"
                            class="toggleBoolean {{#if system.toggles.dragonSeals}}kiBought{{/if}}"
                            data-label="system.toggles.dragonSeals" data-ability="{{system.toggles.dragonSeals}}">
                            {{#if system.toggles.dragonSeals}}
                            <span> {{localize "abfalter.settingsTab.active"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.notActive"}} </span>
                            {{/if}}
                        </button>
                    </label>
                    {{#if system.toggles.dragonSeals}}
                    <label>
                        <span class="settingsSubsectionIndent"> {{localize "abfalter.dragonSealsPer"}} </span>
                        <button type="button" data-action="toggleValue"
                            class="toggleBoolean {{#if system.arsMagnus.dragonPerToggle}}kiBought{{/if}}"
                            data-label="system.arsMagnus.dragonPerToggle" data-ability="{{system.arsMagnus.dragonPerToggle}}">
                            {{#if system.arsMagnus.dragonPerToggle}}
                            <span> {{localize "abfalter.settingsTab.active"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.notActive"}} </span>
                            {{/if}}
                        </button>
                    </label>
                    {{/if}}
                </div>
            </fieldset>
        </div>

        <div class="fieldSetColumnV2 settings2">
            <div>
                <div>
                    <fieldset class="rollRange">
                        <legend> {{localize "abfalter.settingsTab.openRoll"}} </legend>
                        <div class="abfDivFormat">
                            <label> <span> {{localize "abfalter.base"}} </span> <input type="number"
                                    name="system.rollRange.base" value="{{system.rollRange.base}}" /> </label>
                            <label> <span> {{localize "abfalter.spec"}} </span> <input type="number"
                                    name="system.rollRange.spec" value="{{system.rollRange.spec}}" /> </label>
                            <label> <span> {{localize "abfalter.temp"}} </span> <input type="number"
                                    name="system.rollRange.temp" value="{{system.rollRange.temp}}" /> </label>
                            <label>
                                <span> {{localize "abfalter.settingsTab.doubles"}} </span>
                                <button type="button" data-action="toggleValue"
                                    class="toggleBoolean {{#if system.rollRange.doubles}}kiBought{{/if}}"
                                    data-label="system.rollRange.doubles" data-ability="{{system.rollRange.doubles}}">
                                    {{#if system.rollRange.doubles}}
                                    <span> {{localize "abfalter.yes"}} </span>
                                    {{else}}
                                    <span> {{localize "abfalter.no"}} </span>
                                    {{/if}}
                                </button>
                            </label>
                        </div>
                        <div class="abfDivFormat openRollLimits">
                            <span>{{localize "abfalter.rollLimits"}}</span>
                            <div class="csSelect">
                                <select name="system.rollRange.limits">
                                    {{selectOptions openRollLimitsList selected=system.rollRange.limits localize=true}}
                                </select>
                            </div>
                        </div>
                        <div class="abfDivFormat">
                            <label> <span> {{localize "abfalter.final"}} </span> <input type="number"
                                    name="system.rollRange.final" value="{{system.rollRange.final}}" readonly />
                            </label>
                        </div>
                    </fieldset>

                    <fieldset class="rollRange">
                        <legend> {{localize "abfalter.settingsTab.fumbleRoll"}} </legend>
                        <div class="abfDivFormat">
                            <label> <span> {{localize "abfalter.base"}} </span> <input type="number"
                                    name="system.fumleRange.base" value="{{system.fumleRange.base}}" /> </label>
                            <label> <span> {{localize "abfalter.spec"}} </span> <input type="number"
                                    name="system.fumleRange.spec" value="{{system.fumleRange.spec}}" /> </label>
                            <label> <span> {{localize "abfalter.temp"}} </span> <input type="number"
                                    name="system.fumleRange.temp" value="{{system.fumleRange.temp}}" /> </label>
                        </div>
                        <div class="abfDivFormat">
                            <label> <span> {{localize "abfalter.final"}} </span> <input type="number"
                                    name="system.fumleRange.final" value="{{system.fumleRange.final}}" readonly />
                            </label>
                        </div>
                    </fieldset>

                    <fieldset class="speakerOptions">
                        <legend>{{localize "abfalter.speakerOptions"}}</legend>
                        <label>
                            <span>{{localize "abfalter.chooseRollVoice"}}</span>
                            <div class="csSelect">
                                <select name="system.rollRange.speaker">
                                    {{selectOptions rollSpeakerTypeList selected=system.rollRange.speaker localize=true}}
                                </select>
                            </div>
                        </label>
                    </fieldset>
                </div>

                <fieldset class="charOptions">
                    <legend> {{localize "abfalter.settingsTab.charOptions"}} </legend>
                    <div class="abfDivFormat">
                        <label class="lvlModLabel"> 
                            <span> {{localize "abfalter.settingsTab.levelMod"}} </span> 
                            <input type="number"name="system.levelinfo.levelmod" value="{{system.levelinfo.levelmod}}" /> 
                            <span> | </span>
                            <span> {{system.levelinfo.totalLvlMod}} </span>
                        </label>
                        <label> 
                            <span> {{localize "abfalter.settingsTab.presenceMod"}} </span>
                            <input type="number" name="system.levelinfo.presencemod" value="{{system.levelinfo.presencemod}}" /> 
                        </label>
                        <label for="mainDpOffset" class="dpOffSetsLabel"> 
                            <span> {{localize "abfalter.settingsTab.dpMod"}} </span>
                            <button type="button" data-action="openDpOffsets"> 
                                <span> {{localize "abfalter.settingsTab.open"}} </span>
                            </button>
                            <input type="number" id="mainDpOffset" name="system.levelinfo.dpmod" value="{{system.levelinfo.dpmod}}" />
                        </label>
                        
                        <label>
                            <span> {{localize "abfalter.settingsTab.hideBack"}} </span>
                            <button type="button" data-action="toggleValue"
                                class="toggleBoolean {{#if system.toggles.backgroundTab}}kiBought{{/if}}"
                                data-label="system.toggles.backgroundTab"
                                data-ability="{{system.toggles.backgroundTab}}">
                                {{#if system.toggles.backgroundTab}}
                                <span> {{localize "abfalter.settingsTab.hidden"}} </span>
                                {{else}}
                                <span> {{localize "abfalter.settingsTab.notHidden"}} </span>
                                {{/if}}
                            </button>
                        </label>
                        <label>
                            <span> {{localize "abfalter.settingsTab.hideMonster"}} </span>
                            <button type="button" data-action="toggleValue"
                                class="toggleBoolean {{#if system.toggles.monsterTab}}kiBought{{/if}}"
                                data-label="system.toggles.monsterTab" data-ability="{{system.toggles.monsterTab}}">
                                {{#if system.toggles.monsterTab}}
                                <span> {{localize "abfalter.settingsTab.hidden"}} </span>
                                {{else}}
                                <span> {{localize "abfalter.settingsTab.notHidden"}} </span>
                                {{/if}}
                            </button>
                        </label>
                        <label>
                            <span> {{localize "abfalter.settingsTab.hideMagic"}} </span>
                            <button type="button" data-action="toggleValue"
                                class="toggleBoolean {{#if system.toggles.magicTab}}kiBought{{/if}}"
                                data-label="system.toggles.magicTab" data-ability="{{system.toggles.magicTab}}">
                                {{#if system.toggles.magicTab}}
                                <span> {{localize "abfalter.settingsTab.hidden"}} </span>
                                {{else}}
                                <span> {{localize "abfalter.settingsTab.notHidden"}} </span>
                                {{/if}}
                            </button>
                        </label>
                        <label>
                            <span> {{localize "abfalter.settingsTab.hidePsy"}} </span>
                            <button type="button" data-action="toggleValue"
                                class="toggleBoolean {{#if system.toggles.psychicTab}}kiBought{{/if}}"
                                data-label="system.toggles.psychicTab" data-ability="{{system.toggles.psychicTab}}">
                                {{#if system.toggles.psychicTab}}
                                <span> {{localize "abfalter.settingsTab.hidden"}} </span>
                                {{else}}
                                <span> {{localize "abfalter.settingsTab.notHidden"}} </span>
                                {{/if}}
                            </button>
                        </label>
                        <label>
                            <span> {{localize "abfalter.settingsTab.hideKi"}} </span>
                            <button type="button" data-action="toggleValue"
                                class="toggleBoolean {{#if system.toggles.kiTab}}kiBought{{/if}}"
                                data-label="system.toggles.kiTab" data-ability="{{system.toggles.kiTab}}">
                                {{#if system.toggles.kiTab}}
                                <span> {{localize "abfalter.settingsTab.hidden"}} </span>
                                {{else}}
                                <span> {{localize "abfalter.settingsTab.notHidden"}} </span>
                                {{/if}}
                            </button>
                        </label>
                        <label>
                            <span> {{localize "abfalter.settingsTab.hideEffect"}} </span>
                            <button type="button" data-action="toggleValue"
                                class="toggleBoolean {{#if system.toggles.effectTab}}kiBought{{/if}}"
                                data-label="system.toggles.effectTab" data-ability="{{system.toggles.effectTab}}">
                                {{#if system.toggles.effectTab}}
                                <span> {{localize "abfalter.settingsTab.hidden"}} </span>
                                {{else}}
                                <span> {{localize "abfalter.settingsTab.notHidden"}} </span>
                                {{/if}}
                            </button>
                        </label>
                        <label>
                            <span> {{localize "abfalter.settingsTab.hideBio"}} </span>
                            <button type="button" data-action="toggleValue"
                                class="toggleBoolean {{#if system.toggles.bioTab}}kiBought{{/if}}"
                                data-label="system.toggles.bioTab" data-ability="{{system.toggles.bioTab}}">
                                {{#if system.toggles.bioTab}}
                                <span> {{localize "abfalter.settingsTab.hidden"}} </span>
                                {{else}}
                                <span> {{localize "abfalter.settingsTab.notHidden"}} </span>
                                {{/if}}
                            </button>
                        </label>
                        <label>
                            <span> {{localize "abfalter.settingsTab.activateShield"}} </span>
                            <button type="button" data-action="toggleValue"
                                class="toggleBoolean {{#if system.toggles.shield}}kiBought{{/if}}"
                                data-label="system.toggles.shield" data-ability="{{system.toggles.shield}}">
                                {{#if system.toggles.shield}}
                                <span> {{localize "abfalter.settingsTab.notHidden"}} </span>
                                {{else}}
                                <span> {{localize "abfalter.settingsTab.hidden"}} </span>
                                {{/if}}
                            </button>
                        </label>
                        {{#if system.toggles.shield}}
                        <label class="shieldValuesLabel"> 
                            <span> {{localize "abfalter.settingsTab.shieldValues"}} </span> 
                            <input type="number"name="system.shield.value" value="{{system.shield.value}}" /> 
                            <span> / </span>
                            <input type="number"name="system.shield.max" value="{{system.shield.max}}" /> 
                        </label>
                        {{/if}}
                    </div>
                </fieldset>
            </div>

            <fieldset class="innateBonuses">
                <legend> {{localize "abfalter.settingsTab.classLevels"}} </legend>
                <div class="abfDivFormat">
                    <span> {{localize "abfalter.class"}} </span>
                    <span> {{localize "abfalter.level"}} </span>
                </div>

                <div class="abfDivFormat">
                    {{#each classs as |class|}}
                    <div class="class-item item normal-item {{#if ../system.itemToggle.class}}draggable{{/if}}" data-item-id={{id}}
                    data-can-edit="true" data-can-delete="true" data-can-equip="false" data-can-toggle="false">
                        <div>
                            <input class="item-name inline-edit" data-field="name" type="text" value="{{class.name}}"
                                placeholder="{{localize " abfalter.nameItem"}}" />
                            <input class="inline-edit" data-field="system.main.levels" type="number"
                                value="{{class.system.main.levels}}" />
                            <a class="{{#if system.expand}}showOpacity{{/if}}" data-action="itemToggleValue" data-ability="{{system.expand}}" data-label="system.expand"><i
                                    class="{{#if system.expand}}fas fa-caret-up{{else}}fas fa-caret-down{{/if}}"></i></a>
                        </div>
                        {{#if system.expand}}
                        <span> {{localize "abfalter.settingsTab.tempWip"}} </span>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>

                <div class="abfDivFormat">
                    <a class="item-control" data-action="createItem" data-type="class"><i class="fas fa-plus"></i> {{localize
                        "abfalter.settingsTab.addClass"}} </a>
                    <a data-action="toggleValue"
                        class="toggleBoolean {{#if system.itemToggle.class}}armorpenalty{{/if}}"
                        data-label="system.itemToggle.class" data-ability="{{system.itemToggle.class}}"><i
                            class="{{#if system.itemToggle.class}}fa-solid fa-bars-staggered{{else}}fa-solid fa-bars{{/if}}"></i>
                        {{localize "abfalter.modify"}} </a>
                </div>
            </fieldset>
        </div>

    </div>
    <div class="fieldsetContainerRowV2">
        <div class="fieldSetColumnV2 extendedSettingsContainerField">
            <fieldset class="extendedSettingsContainer">
                <legend> {{localize "abfalter.settingsTab.hidePageObjects"}} </legend>

                <div class="extendedSettings abfDivFormat">
                    <label class="setSingleInput {{#if system.toggles.backgroundTab}}hidden{{/if}}">
                        <span> {{localize "abfalter.settingsTab.mentalHealth"}} </span>
                        <button type="button" data-action="toggleValue"
                            class="toggleBoolean {{#if system.toggles.mentalHealthStatus}}kiBought{{/if}}"
                            data-label="system.toggles.mentalHealthStatus" data-ability="{{system.toggles.mentalHealthStatus}}">
                            {{#if system.toggles.mentalHealthStatus}}
                            <span> {{localize "abfalter.settingsTab.notHidden"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.hidden"}} </span>
                            {{/if}}
                        </button>
                    </label>
                    <label class="setSingleInput {{#if system.toggles.backgroundTab}}hidden{{/if}}">
                        <span> {{localize "abfalter.settingsTab.backgroundElan"}} </span>
                        <button type="button" data-action="toggleValue"
                            class="toggleBoolean {{#if system.toggles.elanStatus}}kiBought{{/if}}"
                            data-label="system.toggles.elanStatus" data-ability="{{system.toggles.elanStatus}}">
                            {{#if system.toggles.elanStatus}}
                            <span> {{localize "abfalter.settingsTab.hidden"}} </span>
                            {{else}}
                            <span> {{localize "abfalter.settingsTab.notHidden"}} </span>
                            {{/if}}
