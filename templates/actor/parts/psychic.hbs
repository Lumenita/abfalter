<section class="tab {{tabs.psychic.cssClass}} actorPage baseAbfalterV2" data-group="{{tabs.psychic.group}}" data-tab="{{tabs.psychic.id}}">
    <div class="fieldSetColumnV2 psychic">
        <div class="fieldsetContainerRowV2">        
            <fieldset class="ppoint">
                <legend>
                    {{localize "abfalter.pp"}}
                    <a data-action="toggleValue" class="{{#if system.ppoint.status}}showOpacity{{/if}}" data-label="system.ppoint.status" data-ability="{{system.ppoint.status}}"><i class="{{#if system.ppoint.status}}fas fa-caret-up{{else}}fas fa-caret-down{{/if}}"></i></a>
                </legend>
                <div class="abfDivFormat">
                    {{#if system.ppoint.status}}
                    <div>
                        <label> <span> {{localize "abfalter.base"}} </span> <input type="number" name="system.ppoint.base" value="{{system.ppoint.base}}" /> </label>
                        <label> <span> {{localize "abfalter.spec"}} </span> <input type="number" name="system.ppoint.spec" value="{{system.ppoint.spec}}" /> </label>
                        <label> <span> {{localize "abfalter.extra"}} </span> <input type="number" name="system.ppoint.extra" value="{{system.ppoint.extra}}" /> </label>
                        <label> <span> {{localize "abfalter.class"}} </span> <input type="number" name="system.ppoint.class" value="{{system.ppoint.class}}" readonly /> </label>
                    </div>
                    {{/if}}
                    <label> <span> {{localize "abfalter.final"}} </span> <input type="number" name="system.ppoint.final" value="{{system.ppoint.final}}" readonly /> </label>
                    <label> <span> {{localize "abfalter.freeppMax"}} </span> <input type="number" name="system.psychicPoint.max" value="{{system.psychicPoint.max}}" readonly /> </label>
                    <label> <span> {{localize "abfalter.freepp"}} </span> <input type="number" name="system.psychicPoint.value" value="{{system.psychicPoint.value}}" /> </label>
                </div>
            </fieldset>

            <fieldset class="ppotential">
                <legend>
                    {{localize "abfalter.ppotential"}}
                    <a data-action="toggleValue" class="{{#if system.ppotential.status}}showOpacity{{/if}}" data-label="system.ppotential.status" data-ability="{{system.ppotential.status}}"><i class="{{#if system.ppotential.status}}fas fa-caret-up{{else}}fas fa-caret-down{{/if}}"></i></a>
                </legend>
                <div class="abfDivFormat">
                    {{#if system.ppotential.status}}
                    <div>
                        <label> <span> {{localize "abfalter.spec"}} </span> <input type="number" name="system.ppotential.spec" value="{{system.ppotential.spec}}" /> </label>
                        <label> <span> {{localize "abfalter.extra"}} </span> <input type="number" name="system.ppotential.base" value="{{system.ppotential.base}}" /> </label>
                        <label> <span> {{localize "abfalter.fromWP"}} </span> <input type="number" name="system.ppotential.wpBase" value="{{system.ppotential.wpBase}}" readonly/> </label>
                        <div class="csSelect1">
                            <label>
                                <span> {{localize "abfalter.spent"}} </span>
                                <select name="system.ppotential.spent">
                                    {{selectOptions ppotentialObjList selected=system.ppotential.spent localize=true}}
                                </select>
                            </label>
                        </div>
                    </div>
                    {{/if}}
                    <label> <span> {{localize "abfalter.temp"}} </span> <input type="number" name="system.ppotential.temp" value="{{system.ppotential.temp}}" /> </label>
                    <label> <span> {{localize "abfalter.final"}} </span> <input type="number" name="system.ppotential.final" value="{{system.ppotential.final}}" readonly/> </label>
                    <div class="ppotButton">
                        <button type="button" data-action="abfRollButton" data-label="psychicPotential">
                            <span> <i class="fas fa-dice-d20"></i> </span>
                        </button>
                        <button type="button" data-action="abfRollButton" data-label="castMatrix">
                            <span> {{localize "abfalter.castMatrix"}} </span>
                        </button>
                    </div>
                </div>
            </fieldset>

            <fieldset class="pproj">
                <legend>
                    {{localize "abfalter.pproj"}}
                    <a data-action="toggleValue" class="{{#if system.pproj.status}}showOpacity{{/if}}" data-label="system.pproj.status" data-ability="{{system.pproj.status}}"><i class="{{#if system.pproj.status}}fas fa-caret-up{{else}}fas fa-caret-down{{/if}}"></i></a>
                </legend>
                <div class="abfDivFormat">
                    {{#if system.pproj.status}}
                    <div>
                        <label> <span> {{localize "abfalter.base"}} </span> <input type="number" name="system.pproj.base" value="{{system.pproj.base}}" /> </label>
                        <label> <span> {{localize "abfalter.spec"}} </span> <input type="number" name="system.pproj.spec" value="{{system.pproj.spec}}" /> </label>
                        <label> 
                            <span> {{localize "abfalter.extra"}} </span>
                            <input type="number" name="system.pproj.extraOff" value="{{system.pproj.extraOff}}" />
                            <input type="number" name="system.pproj.extraDef" value="{{system.pproj.extraDef}}" /> 
                        </label>
                    </div>
                    {{/if}}
                    <label> <span> {{localize "abfalter.temp"}} </span> <input type="number" name="system.pproj.temp" value="{{system.pproj.temp}}" /> </label>
                    {{#if system.toggles.psychicModuleStatus}}
                    <div class="pmodButton">
                        <!--<button type="button" data-action="abfRollButton" data-label="offPsyProj" data-value="{{system.pproj.atkModule}}">
                            <span> {{localize "abfalter.attack"}}: {{system.pproj.atkModule}} </span>
                        </button>-->
                        <button type="button" data-action="plainRoll" data-roll="{{system.pproj.atkModule}}" data-label="offPsyProj" data-type="combatRoll">
                            <span> {{localize "abfalter.attack"}} </span> <span> {{system.pproj.atkModule}} </span>
                        </button>
                        {{#if system.toggles.psychicDodgeStatus}}
                        <button type="button" data-action="abfRollButton" data-label="defPsyProj" data-value="{{system.pproj.dodModule}}">
                            <span> {{localize "abfalter.dodge"}}: {{system.pproj.dodModule}} </span>
                        </button>
                        {{else}}
                        <button type="button" data-action="abfRollButton" data-label="defPsyProj" data-value="{{system.pproj.defModule}}">
                            <span> {{localize "abfalter.block"}}: {{system.pproj.defModule}} </span>
                        </button>
                        {{/if}}
                    </div>
                    {{else}}
                    <div class="pmodButton">
                        <!--<button type="button" data-action="abfRollButton" data-label="offPsyProj" data-value="{{system.pproj.finalOff}}">
                            <span> <i class="fas fa-dice-d20"></i> </span>
                        </button>-->
                        <button type="button" data-action="plainRoll" data-roll="{{system.pproj.finalOff}}" data-label="offPsyProj" data-type="combatRoll">
                            <span> {{localize "abfalter.offensive"}} </span> <span> {{system.pproj.finalOff}} </span>
                        </button>
                        <button type="button" data-action="abfRollButton" data-label="defPsyProj" data-value="{{system.pproj.finalDef}}">
                            <span> {{localize "abfalter.defensive"}} </span> <span> {{system.pproj.finalDef}} </span>
                        </button>
                    </div>
                    {{/if}}
                </div>
            </fieldset>

            <fieldset class="pdisc">
                <legend> {{localize "abfalter.pdisc"}} </legend>
                <div>
                    {{#each disciplines as |discipline|}}
                    <div class="discipline-item item normal-itemV2 {{#if ../system.itemToggle.discipline}}draggable{{/if}}" data-item-id={{id}}>
                        <div class="abfDivFormat">
                            {{#if system.toggleItem}}
                            <span> {{discipline.name}} </span>
                            {{else}}
                            <input class="item-name inline-edit" data-field="name" type="text" value="{{discipline.name}}" placeholder="{{localize "abfalter.nameItem"}}" />
                            {{/if}}
                        </div>
                    </div>
                    {{/each}}
                </div>
                <div class="itemControlsV2">
                    <a class="item-control" data-action="createItem" data-type="discipline"><i class="fas fa-plus"></i> {{localize "abfalter.paddDisc"}} </a>
                    <a data-action="toggleValue" class="{{#if system.itemToggle.discipline}}armorpenalty{{/if}}" data-label="system.itemToggle.discipline" data-ability="{{system.itemToggle.discipline}}"><i class="{{#if system.itemToggle.discipline}}fa-solid fa-bars-staggered{{else}}fa-solid fa-bars{{/if}}"></i> {{localize "abfalter.modify"}} </a>
                </div>
            </fieldset>
        </div>

        <div class="fieldSetColumnV2">
            <div class="psyDualContainer">
                <fieldset class="ppaterns {{#if system.toggles.mentalPatternsvis}}hidden{{/if}}">
                    <legend> {{localize "abfalter.mentalPatterns"}} </legend>
                    <div>
                        <span> </span>
                        <span> {{localize "abfalter.cancelled"}} </span>
                        <span> {{localize "abfalter.totalCost"}} </span>
                    </div>
                    <div>
                        {{#each mentalPatterns as |mentalPattern|}}
                        <div class="mentalPattern-item item normal-itemV2 {{#if ../system.itemToggle.mentalPattern}}draggable{{/if}}" data-item-id={{id}}>
                            <div>
                                <span> {{mentalPattern.name}} </span>
                                {{#if system.toggle}}
                                <span> {{localize "abfalter.yes"}} </span>
                                {{else}}
                                <span> {{localize "abfalter.no"}} </span>
                                {{/if}}
                                <span> {{mentalPattern.system.finalCost}} {{localize "abfalter.dp"}} </span>
                                <a data-action="itemToggleValue" data-ability="{{system.expand}}" data-label="system.expand"><i class="{{#if system.expand}}fas fa-caret-up{{else}}fas fa-caret-down{{/if}}"></i></a>
                            </div>
                            {{#if system.expand}}
                            <div class="patternDesc">
                                <span> {{localize "abfalter.bonus"}} </span>
                                <div class="matrixDescription">
                                    {{{enrichedDesc}}}
                                </div>
                                <span> {{localize "abfalter.penalty"}} </span>
                                <div class="matrixDescription">
                                    {{{enrichedPenalty}}}
                                </div>
                            </div>
                            {{/if}}
                        </div>
                        {{/each}}
                    </div>
                    <div class="itemControls">
                        <a class="item-control" data-action="createItem" data-type="mentalPattern"><i class="fas fa-plus"></i> {{localize "abfalter.addMentalPattern"}} </a>
                        <a data-action="toggleValue" class="{{#if system.itemToggle.mentalPattern}}armorpenalty{{/if}}" data-label="system.itemToggle.mentalPattern" data-ability="{{system.itemToggle.mentalPattern}}">
                            <i class="{{#if system.itemToggle.mentalPattern}}fa-solid fa-bars-staggered{{else}}fa-solid fa-bars{{/if}}"></i> 
                        {{localize "abfalter.modify"}} </a>                    
                    </div>
                </fieldset>

                <fieldset class="pmaint">
                    <legend> {{localize "abfalter.maintMatrix"}} </legend>
                    <div class="abfDivFormat pMaintPP">
                        <label> 
                            <span> {{localize "abfalter.numOfSlots"}} </span> 
                            <input type="number" name="system.other.innateSlots" value="{{system.other.innateSlots}}" /> 
                            <span>|</span>
                            <span>{{system.ppoint.maxInnateSlots}}</span>
                        </label>
                        <label> 
                            <span> {{localize "abfalter.totalppSlots"}} </span> 
                            <input type="number" name="system.ppoint.innateSlotCost" value="{{system.ppoint.innateSlotCost}}" readonly /> 
                        </label>
                    </div>
                    <div class="abfDivFormat pMaintPotency">
                        <label>
                            <span>{{localize "abfalter.fullPotency"}}: {{system.ppotential.finalMaintPotency}}</span>
                        </label>
                        <label>
                            <span>{{localize "abfalter.freePPUsed"}}: </span>
                            <input type="number" name="system.ppoint.innateFreePP" value="{{system.ppoint.innateFreePP}}" readonly /> 
                        </label>
                    </div>
                    
                    <div class="pMaintHeader">
                        <span> </span>
                        <span> {{localize "abfalter.potency"}} </span>
                    </div>
                    <div>
                        {{#each maintPowers as |maintPower|}}
                        <div class="maintPower-item item normal-itemV2 {{#if ../system.itemToggle.maintPowers}}draggable{{/if}}" data-item-id={{id}}>
                            <div class="{{#if system.equipped}}equipped{{else}}notEquipped{{/if}}">
                                <span> {{maintPower.name}} </span>
                                <span>
                                    {{#if system.linked}} {{localize "abfalter.linked"}} {{/if}}
                                </span>
                                <span> {{system.maintPotencyAchieved}} </span>
                                <a class="{{#if system.expand}}showOpacity{{/if}}" data-action="itemToggleValue" data-ability="{{system.expand}}" data-label="system.expand">
                                    <i class="{{#if system.expand}}fas fa-caret-up{{else}}fas fa-caret-down{{/if}}"></i>
                                </a>
                            </div>
                            {{#if system.expand}}
                            <div class="matrixDescription">
                                {{{enrichedDesc}}}
                            </div>
                            {{/if}}
                        </div>
                        {{/each}}
                    </div>
                    <div class="itemControls">
                        <a class="item-control" data-action="createItem" data-type="maintPower"><i class="fas fa-plus"></i> {{localize "abfalter.addMaintMatrix"}} </a>
                        <a data-action="toggleValue" class="{{#if system.itemToggle.maintPowers}}armorpenalty{{/if}}" data-label="system.itemToggle.maintPowers" data-ability="{{system.itemToggle.maintPowers}}"><i class="{{#if system.itemToggle.maintPowers}}fa-solid fa-bars-staggered{{else}}fa-solid fa-bars{{/if}}"></i> {{localize "abfalter.modify"}} </a>
                    </div>
                </fieldset>
            </div>

            <div class="matrixMatrices">
                <div class="matrixItemHeader abfDivFormat">
                    <span class="matrixNameHeader"> {{localize "abfalter.psychicMatrices"}} </span>
                    <span class="matrixPPHeader"> {{localize "abfalter.ppInvested"}} </span>
                    <span class="matrixBonusHeader"> {{localize "abfalter.bonusPotential"}} </span>
                    <span class="addHeader">
                        <a class="item-control" data-action="createItem" data-type="psychicMatrix">
                            <i class="fas fa-plus"></i> 
                            {{localize "abfalter.add"}}
                        </a>
                    </span>
                </div>

                {{#each psychicMatrixs as |matrix|}}
                    <div class="matrix-item item normal-itemV2 draggable" data-item-id={{id}}>
                        <div class="matrixItemContainer abfDivFormat">
                            <div class="matrixItemMain">
                                <img class="matrixItemImg" src="{{img}}"/>
                                <div class="matrixItemNames">
                                    <span class="{{#if system.equipped}}equipped{{/if}}" data-action="itemToChat"> {{matrix.name}} </span>
                                    <span> {{system.descTag}} </span>
                                </div>
                            </div>
                            <div class="matrixPP">
                                <span > {{system.ppInvested}} {{localize "abfalter.pp"}}</span>
                            </div>
                            <div class="matrixBonus">
                                <span > {{system.finalPot}} </span>
                            </div>
                            <div class="matrixItemControls">
                                <a class="{{#if system.favorite}}favorite{{/if}} hidden" data-action="itemToggleValue" data-label="system.favorite" data-ability="{{system.favorite}}">
                                    {{#if system.favorite}}
                                    <i class="fa-solid fa-star"></i>
                                    {{else}}
                                    <i class="fa-regular fa-star"></i>
                                    {{/if}}
                                </a>
                                <a data-action="itemToggleValue" data-label="system.expand" data-ability="{{system.expand}}">
                                    {{#if system.expand}}
                                    <i class="fa-solid fa-compress"></i>
                                    {{else}}
                                    <i class="fa-solid fa-expand"></i>
                                    {{/if}}
                                </a>
                            </div>
                        </div>

                        {{#if system.expand}}
                        <div class="matrixDescription">
                            {{{enrichedDesc}}}
                        </div>

                        <div class="matrixDetailsList">
                            {{#each matrix.system.matrixDetails as |matrices key|}}
                                <div class="matrixDetailEntry {{#if matrices.failure}}matrixFailureEntry{{/if}}"
                                    data-action="itemToggleNestedValue" data-path="system.matrixDetails.{{key}}.toggle">
                                    <div class="matrixDetailHeader">
                                        <span class="matrixTitleNum">
                                            {{matrices.titleNum}}
                                        </span>
                                        <span class="matrixDetailTitle">
                                            {{localize (concat "abfalter." matrices.title)}}
                                        </span>
                                        {{#unless matrices.failure}}
                                        <span class="matrixInfoLine">
                                            {{matrices.infoLine}}
                                        </span>
                                        {{/unless}}
                                    </div>
                                </div>

                                {{#if matrices.toggle}}
                                <div class="matrixDetailBody">
                                    <span class="matrixDetailBranch">┗</span>

                                    {{#if matrices.failure}}
                                        <div class="matrixFailureText">
                                            {{localize "abfalter.fatigue"}}:
                                            <span class="matrixFatigueValue">
                                                {{matrices.fatigue}}
                                            </span>
                                        </div>
                                    {{else}}
                                        <div class="matrixDetailDescription">
                                            {{{matrices.enrichedDesc}}}
                                        </div>
                                    {{/if}}
                                </div>
                                {{/if}}
                            {{/each}}
                        </div>
                        {{/if}}
                    </div>
                {{/each}}
            </div>
        </div>
    </div>
</section>