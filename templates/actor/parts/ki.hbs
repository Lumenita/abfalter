                        <button type="button" data-action="toggleBoughtFreeButton" class="kiAbility {{#if system.kiSeal.minor.water.mastery}}{{#if system.kiSeal.minor.water.mastery2}}kiFree{{else}}kiBought{{/if}}{{else}}kiNotBought{{/if}}"
                                data-label="system.kiSeal.minor.water.mastery" data-label2="system.kiSeal.minor.water.mastery2" data-ability="{{system.kiSeal.minor.water.mastery}}" data-ability2="{{system.kiSeal.minor.water.mastery2}}">
                            <span> {{localize "abfalter.minor"}} </span>
                        </button>
                        <button type="button" data-action="toggleBoughtFreeButton" class="kiAbility {{#if system.kiSeal.minor.fire.mastery}}{{#if system.kiSeal.minor.fire.mastery2}}kiFree{{else}}kiBought{{/if}}{{else}}kiNotBought{{/if}}"
                                data-label="system.kiSeal.minor.fire.mastery" data-label2="system.kiSeal.minor.fire.mastery2" data-ability="{{system.kiSeal.minor.fire.mastery}}" data-ability2="{{system.kiSeal.minor.fire.mastery2}}">
                            <span> {{localize "abfalter.minor"}} </span>
                        </button>
                    </div>
                    <div class="abfDivFormat">
                        <span> {{localize "abfalter.majorCost"}} </span>
                        <button type="button" data-action="toggleBoughtFreeButton" class="kiAbility {{#if system.kiSeal.major.wood.mastery}}{{#if system.kiSeal.major.wood.mastery2}}kiFree{{else}}kiBought{{/if}}{{else}}kiNotBought{{/if}}"
                                data-label="system.kiSeal.major.wood.mastery" data-label2="system.kiSeal.major.wood.mastery2" data-ability="{{system.kiSeal.major.wood.mastery}}" data-ability2="{{system.kiSeal.major.wood.mastery2}}">
                            <span> {{localize "abfalter.major"}} </span>
                        </button>
                        <button type="button" data-action="toggleBoughtFreeButton" class="kiAbility {{#if system.kiSeal.major.metal.mastery}}{{#if system.kiSeal.major.metal.mastery2}}kiFree{{else}}kiBought{{/if}}{{else}}kiNotBought{{/if}}"
                                data-label="system.kiSeal.major.metal.mastery" data-label2="system.kiSeal.major.metal.mastery2" data-ability="{{system.kiSeal.major.metal.mastery}}" data-ability2="{{system.kiSeal.major.metal.mastery2}}">
                            <span> {{localize "abfalter.major"}} </span>
                        </button>
                        <button type="button" data-action="toggleBoughtFreeButton" class="kiAbility {{#if system.kiSeal.major.air.mastery}}{{#if system.kiSeal.major.air.mastery2}}kiFree{{else}}kiBought{{/if}}{{else}}kiNotBought{{/if}}"
                                data-label="system.kiSeal.major.air.mastery" data-label2="system.kiSeal.major.air.mastery2" data-ability="{{system.kiSeal.major.air.mastery}}" data-ability2="{{system.kiSeal.major.air.mastery2}}">
                            <span> {{localize "abfalter.major"}} </span>
                        </button>
                        <button type="button" data-action="toggleBoughtFreeButton" class="kiAbility {{#if system.kiSeal.major.water.mastery}}{{#if system.kiSeal.major.water.mastery2}}kiFree{{else}}kiBought{{/if}}{{else}}kiNotBought{{/if}}"
                                data-label="system.kiSeal.major.water.mastery" data-label2="system.kiSeal.major.water.mastery2" data-ability="{{system.kiSeal.major.water.mastery}}" data-ability2="{{system.kiSeal.major.water.mastery2}}">
                            <span> {{localize "abfalter.major"}} </span>
                        </button>
                        <button type="button" data-action="toggleBoughtFreeButton" class="kiAbility {{#if system.kiSeal.major.fire.mastery}}{{#if system.kiSeal.major.fire.mastery2}}kiFree{{else}}kiBought{{/if}}{{else}}kiNotBought{{/if}}"
                                data-label="system.kiSeal.major.fire.mastery" data-label2="system.kiSeal.major.fire.mastery2" data-ability="{{system.kiSeal.major.fire.mastery}}" data-ability2="{{system.kiSeal.major.fire.mastery2}}">
                            <span> {{localize "abfalter.major"}} </span>
                        </button>
                    </div>
                </div>
                {{/if}}
                <div class="kiSealsCreatures">
                    <div class="kiSealHeader">
                        <span> </span>
                        <span> {{localize "abfalter.level"}} </span>
                    </div>
                    <div>
                        {{#each kiSealCreatures as |kiSealCreature|}}
                        <div class="kiSealCreature-item item normal-itemV2 {{#if ../system.itemToggle.kiSealCreature}}draggable{{/if}}" data-item-id={{id}}>
                            <div>
                                <span> {{kiSealCreature.name}} </span>
                                <span> {{kiSealCreature.system.level}} </span>
                                <a class="{{#if system.expand}}showOpacity{{/if}}" data-action="itemToggleValue" data-ability="{{system.expand}}" data-label="system.expand"><i class="{{#if system.expand}}fas fa-caret-up{{else}}fas fa-caret-down{{/if}}"></i></a>
                            </div>
                            {{#if system.showSeals}}
                            <div class="actorKiSeals">
                                <div>
                                    <span> {{localize "abfalter.sealType"}} </span>
                                    <span> {{localize "abfalter.sealWood"}} </span>
                                    <span> {{localize "abfalter.sealMetal"}} </span>
                                    <span> {{localize "abfalter.sealAir"}} </span>
                                    <span> {{localize "abfalter.sealWater"}} </span>
                                    <span> {{localize "abfalter.sealFire"}} </span>
                                </div>
                                <div>
                                    <span> {{localize "abfalter.minor"}} </span>
                                    <span>{{kiSealCreature.system.minor.wood}}</span>
                                    <span>{{kiSealCreature.system.minor.metal}}</span>
                                    <span>{{kiSealCreature.system.minor.air}}</span>
                                    <span>{{kiSealCreature.system.minor.water}}</span>
                                    <span>{{kiSealCreature.system.minor.fire}}</span>
                                </div>
                                <div>
                                    <span> {{localize "abfalter.major"}} </span>
                                    <span>{{kiSealCreature.system.major.wood}}</span>
                                    <span>{{kiSealCreature.system.major.metal}}</span>
                                    <span>{{kiSealCreature.system.major.air}}</span>
                                    <span>{{kiSealCreature.system.major.water}}</span>
                                    <span>{{kiSealCreature.system.major.fire}}</span>
                                </div>
                            </div>
                            {{/if}}
                            {{#if system.showDesc}}
                            <section class="actorItemEnrichedDesc">
                                {{{enrichedDesc}}}
                            </section>
                            {{/if}}
                        </div>
                        {{/each}}
                    </div>
                    <div class="itemControls">
                        <a class="item-control" data-action="createItem" data-type="kiSealCreature"><i class="fas fa-plus"></i> {{localize "abfalter.addKiSealCreature"}} </a>
                        <a data-action="toggleValue" class="{{#if system.itemToggle.kiSealCreature}}armorpenalty{{/if}}" data-label="system.itemToggle.kiSealCreature" data-ability="{{system.itemToggle.kiSealCreature}}"><i class="{{#if system.itemToggle.kiSealCreature}}fa-solid fa-bars-staggered{{else}}fa-solid fa-bars{{/if}}"></i> {{localize "abfalter.modify"}} </a>
                    </div>
                </div>
            </fieldset>

            <fieldset class="kiTech {{#if system.toggles.kiTech}}hidden{{/if}}">
                <legend> {{localize "abfalter.kiTechnique"}} </legend>
                <div>
                    {{#each kiTechniques as |kiTechnique|}}
                    <div class="kiTechnique-item item normal-itemV2 {{#if ../system.itemToggle.kiTechnique}}draggable{{/if}}" data-item-id={{id}}>
                        {{#if system.expand}}
                        <div class="kiTechMainInfo {{#if system.active}}equipped{{/if}} {{#if system.hold}}kiHold{{/if}}">
                            <a class="item-control" data-action="itemToChat"><i class="fas fa-comment-dots"></i></a>
                            <span> {{kiTechnique.name}} </span>
                            <span> {{localize "abfalter.level"}}: {{kiTechnique.system.level}} </span>
                            <span> {{localize "abfalter.mk"}}: {{kiTechnique.system.mk}} </span>
                            <a class="{{#if system.expand}}showOpacity{{/if}}" data-action="itemToggleValue" data-ability="{{system.expand}}" data-label="system.expand"><i class="{{#if system.expand}}fas fa-caret-up{{else}}fas fa-caret-down{{/if}}"></i></a>
                        </div>
                        <div class="kiTechSubheader {{#if system.active}}equipped{{/if}} {{#if system.hold}}kiHold{{/if}}">
                            <span> {{kiTechnique.system.combinedLabel}} </span>
                        </div>
                        <div class="kiTechStatsGrid" style="--char-count: {{system.showColumnNumber}}">
                            <div class="kiTechFirstGrid kiTechFirstRow">{{localize "abfalter.kiAbilityData.char"}}</div>
                            {{#each system.use as |val key|}}
                            {{#if (gt val 0)}}
                            <div class="kiTechFirstRow">{{localize (concat "abfalter." key)}}</div>
                            {{/if}}
                            {{/each}}

                            <div class="kiTechFirstGrid">{{localize "abfalter.ki"}}</div>
                            {{#each system.use as |val key|}}
                            {{#if (gt val 0)}}
                            <div>{{val}}</div>
                            {{/if}}
                            {{/each}}

                            {{#if (and system.maintBool (not system.unified))}}
                            <div class="kiTechFirstGrid">{{localize "abfalter.maint"}}</div>
                            {{#each system.use as |val key|}}
                            {{#if (gt val 0)}}
                            <div>{{lookup ../system.maint key}}</div>
                            {{/if}}
                            {{/each}}
                            {{/if}}
                        </div>

                        {{#if (and system.maintBool system.unified)}}
                        <div class="kiTechUnifiedMaint">
                            <span>{{localize "abfalter.unifiedMaintLong"}}:</span>
                            <span>{{system.maint.unified}}</span>
                        </div>
                        {{/if}}

                        <section class="actorItemEnrichedDesc">
                            {{{enrichedDesc}}}
                        </section>

                        {{else}}
                        <div class="kiTechMainInfo {{#if system.active}}equipped{{/if}} {{#if system.hold}}kiHold{{/if}}">
                            <a class="item-control" data-action="itemToChat"><i class="fas fa-comment-dots"></i></a>
                            <span> {{kiTechnique.name}} </span>
                            <span> {{localize "abfalter.level"}}: {{kiTechnique.system.level}} </span>
                            <span> {{localize "abfalter.mk"}}: {{kiTechnique.system.mk}} </span>
                            <a class="{{#if system.expand}}showOpacity{{/if}}" data-action="itemToggleValue" data-ability="{{system.expand}}" data-label="system.expand"><i class="{{#if system.expand}}fas fa-caret-up{{else}}fas fa-caret-down{{/if}}"></i></a>
                        </div>
                        <div class="kiTechSubheader {{#if system.active}}equipped{{/if}} {{#if system.hold}}kiHold{{/if}}">
                            <span> {{kiTechnique.system.combinedLabel}} </span>
                        </div>
                        {{#if system.showStats}}
                        <div class="kiTechStatsGrid" style="--char-count: {{system.showColumnNumber}}">
                            <div class="kiTechFirstGrid kiTechFirstRow">{{localize "abfalter.kiAbilityData.char"}}</div>
                            {{#each system.use as |val key|}}
                            {{#if (gt val 0)}}
                            <div class="kiTechFirstRow">{{localize (concat "abfalter." key)}}</div>
                            {{/if}}
                            {{/each}}

                            <div class="kiTechFirstGrid">{{localize "abfalter.ki"}}</div>
                            {{#each system.use as |val key|}}
                            {{#if (gt val 0)}}
                            <div>{{val}}</div>
                            {{/if}}
                            {{/each}}

                            {{#if (and system.maintBool (not system.unified))}}
                            <div class="kiTechFirstGrid">{{localize "abfalter.maint"}}</div>
                            {{#each system.use as |val key|}}
                            {{#if (gt val 0)}}
                            <div>
                                {{#if (eq (lookup ../system.maint key) 0)}}
                                -
                                {{else}}
                                {{lookup ../system.maint key}}
                                {{/if}}
                            </div>
                            {{/if}}
                            {{/each}}
                            {{/if}}
                        </div>

                        {{#if (and system.maintBool system.unified)}}
                        <div class="kiTechUnifiedMaint">
                            <span>{{localize "abfalter.unifiedMaintLong"}}:</span>
                            <span>{{system.maint.unified}}</span>
                        </div>
                        {{/if}}
                        {{/if}}

                        {{#if system.showDesc}}
                        <section class="actorItemEnrichedDesc">
                            {{{enrichedDesc}}}
                        </section>
                        {{/if}}

                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                <div class="itemControls">
                    <a class="item-control" data-action="createItem" data-type="kiTechnique"><i class="fas fa-plus"></i> {{localize "abfalter.addKiTechnique"}} </a>
                    <a data-action="toggleValue" class="{{#if system.itemToggle.kiTechnique}}armorpenalty{{/if}}" data-label="system.itemToggle.kiTechnique" data-ability="{{system.itemToggle.kiTechnique}}"><i class="{{#if system.itemToggle.kiTechnique}}fa-solid fa-bars-staggered{{else}}fa-solid fa-bars{{/if}}"></i> {{localize "abfalter.modify"}} </a>
                </div>
            </fieldset>
        </div>
    </div>
</section>
