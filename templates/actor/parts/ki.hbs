                                data-label="system.kiSeal.minor.wood.mastery" data-label2="system.kiSeal.minor.wood.mastery2" data-ability="{{system.kiSeal.minor.wood.mastery}}" data-ability2="{{system.kiSeal.minor.wood.mastery2}}">
                            <span> {{localize "abfalter.minor"}} </span>
                        </button>
                        <button type="button" data-action="toggleBoughtFreeButton" class="kiAbility {{#if system.kiSeal.minor.metal.mastery}}{{#if system.kiSeal.minor.metal.mastery2}}kiFree{{else}}kiBought{{/if}}{{else}}kiNotBought{{/if}}"
                                data-label="system.kiSeal.minor.metal.mastery" data-label2="system.kiSeal.minor.metal.mastery2" data-ability="{{system.kiSeal.minor.metal.mastery}}" data-ability2="{{system.kiSeal.minor.metal.mastery2}}">
                            <span> {{localize "abfalter.minor"}} </span>
