                                data-label="system.kiSeal.minor.air.mastery" data-label2="system.kiSeal.minor.air.mastery2" data-ability="{{system.kiSeal.minor.air.mastery}}" data-ability2="{{system.kiSeal.minor.air.mastery2}}">
                            <span> {{localize "abfalter.minor"}} </span>
