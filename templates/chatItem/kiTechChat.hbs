{{> "systems/abfalter/templates/dialogues/partials/customChatHeader.hbs"}}
<div class="itemChat baseAbfalterV2">
    <div class="chatItemContent">
        <div class="chatItemHeader">
            <img src="{{img}}"/>
            <div>
                <span> {{name}} </span>
                <span> {{system.combinedLabel}} </span>
            </div>
            <a class="descToggle" data-value="{{descToggle}}">
                <i class="fas fa-chevron-right fa-fw"></i>
            </a>
        </div>

        <div class="itemDescription {{#if descToggle}}ItemDescOpen{{/if}}">
            {{{system.description}}}
        </div>
    </div>


    <div class="kiTechChat">
        <div class="kiChatRow">
            <span class="kiChatLabel"></span>
            <div class="kiChatTypes">
                {{#each kiAttributes}}
                    <span>{{this.label}}</span>
                {{/each}}
            </div>
        </div>

        <div class="kiChatRow">
            <span class="kiChatLabel">{{localize "abfalter.cost"}}</span>
            <div class="kiChatTypes">
                {{#each kiAttributes}}
                    <span>{{this.use}}</span>
                {{/each}}
            </div>
        </div>

        <div class="kiChatRow kiChatBorderHere">
            {{#if system.unified}}
                <div class="kiChatUnified">
                    {{#if system.innatePower}}
                        <span>{{system.maint.unified}}</span>
                    {{else}}
                        <span>
                            {{localize "abfalter.unifiedMaint"}}:
                            {{system.maint.unified}}
                        </span>
                    {{/if}}
                </div>
            {{else}}
                <span class="kiChatLabel">{{localize "abfalter.maint"}}</span>
                <div class="kiChatTypes">
                    {{#each kiAttributes}}
                        <span>{{this.maint}}</span>
                    {{/each}}
                </div>
            {{/if}}
        </div>
    </div>


</div>
