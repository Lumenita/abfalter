<form class="flexcol">
    <div class="kiCastTechniques">
        {{#each techniques}}
        <div class="kiCastTechnique" data-technique-id="{{id}}">
            <input type="checkbox" class="kiCastSelect" data-technique-id="{{id}}">

            <div class="kiCastTechniqueInfo">
                <span>
                    {{name}}{{#if held}} ({{localize "abfalter.onHold"}}){{/if}}
                </span>

                <div class="kiCastTechniqueCost">
                    {{#each costs}}
                    <span class="{{#if insufficient}}kiCostInsufficient{{/if}}">
                        {{label}} {{value}}
                    </span>
                    {{#unless @last}} / {{/unless}}
                    {{/each}}
                </div>
            </div>

            <div class="kiCastPushContainer">
                {{#if held}}
                {{#if heldPushed}}
                <span class="kiCastPushed">
                    {{localize "abfalter.pushedCap"}}
                </span>
                {{/if}}
                {{else}}
                {{#if canPush}}
                <label class="kiCastPushLabel">
                    <input type="checkbox" class="kiCastPush" data-technique-id="{{id}}">
                    {{localize "abfalter.push"}}
                </label>
                {{/if}}
                {{/if}}
            </div>

            <div class="kiCastModeContainer">
                {{#if held}}
                <span class="kiCastHeldCast">
                    {{localize "abfalter.cast"}}
                </span>
                {{else}}
                <select class="kiCastMode" data-technique-id="{{id}}" disabled>
                    <option value="cast">{{localize "abfalter.cast"}}</option>
                    <option value="hold">{{localize "abfalter.hold"}}</option>
                </select>
                {{/if}}
            </div>
        </div>
        {{/each}}
    </div>

    <div class="kiCastSummary">
        <span>{{localize "abfalter.accuResult"}}</span>
        <div class="kiAccumResult">{{localize "abfalter.noChange"}}</div>

        <div class="kiAccumWarning" style="display:none;">
            {{localize "abfalter.noAccuKi"}}
        </div>

        <span style="display:block;margin-top:8px;">
            {{localize "abfalter.activeResult"}}
        </span>

        <div class="kiActualResult">{{localize "abfalter.noChange"}}</div>

        <div class="kiActualWarning" style="display:none;">
            {{localize "abfalter.noReserveKi"}}
        </div>
    </div>

</form>