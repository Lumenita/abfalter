<form>
    {{#if showKiOptions}}
    <hr>

    <div class="form-group">
        <label>Ki Accumulation</label>
        <select name="kiAmount">
            <option value="full">Full Accumulation</option>
            <option value="half">Half Accumulation</option>
        </select>
    </div>

    <div class="form-group">
        <label>
            <input type="checkbox" name="removeHalf">
            Remove Half Accumulation from Last Turn
        </label>
    </div>
    {{/if}}

    <div class="form-group">
        <label>{{content}}</label>
        <input id="dialog-input"
               type="number"
               name="dialog-input"
               placeholder="{{placeholder}}" />
    </div>
</form>