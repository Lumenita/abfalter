<form>
    {{#if showKiOptions}}
    <div class="form-group">
        <label>{{localize "abfalter.kiAccumulation"}}</label>
        <select name="kiAmount">
            <option value="full">{{localize "abfalter.fullAccu"}}</option>
            <option value="half">{{localize "abfalter.halfAccu"}}</option>
        </select>
    </div>

    <div class="form-group">
        <label>
            <input type="checkbox" name="removeHalf">
            {{localize "abfalter.removeHalfAccu"}}
        </label>
    </div>
    {{/if}}

    <div class="abfDivFormat form-group">
        <label>{{content}}</label>
        <input id="dialog-input"
               type="number"
               name="dialog-input"
               placeholder="{{placeholder}}" />
    </div>
</form>