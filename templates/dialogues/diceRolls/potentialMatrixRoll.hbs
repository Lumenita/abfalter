{{> "systems/abfalter/templates/dialogues/partials/customChatHeader.hbs"}}

<div class="baseAbfalterV2 defaultRollMsg itemChat">
    <div class="chatItemContent">
        <div class="chatItemHeader">
            <img src="{{matrixDetails.img}}"/>
            <div>
                <span> {{matrixDetails.name}} </span>
                <div> {{matrixDetails.tag}} </div>
            </div>
            <a class="descToggle" data-value="{{descToggle}}">
                <i class="fas fa-chevron-right fa-fw"></i>
            </a>
        </div>

        <div class="itemDescription {{#if descToggle}}ItemDescOpen{{/if}}">
            {{{matrixDetails.desc}}}
        </div>
    </div>

    {{> "systems/abfalter/templates/dialogues/partials/customDefaultRoll.hbs"}}

    {{#each rollData as |roll i|}}
    <label class="explodeButtons">
        {{#if roll.explode}}
        <button class="potentialContinuationRoll" data-roll-type="open"> {{localize "abfalter.dialogs.openRoll"}} </button>
        {{/if}}
        {{#if roll.fumble}}
        <button class="potentialContinuationRoll" data-roll-type="fumble"> {{localize "abfalter.dialogs.fumbleSeverity2"}} </button>
        {{/if}}
    </label>
    {{/each}}

    {{#if matrixDetails.resolved}}
    {{#if matrixResolution.failed}}
    <div class="matrixFailure">
        <h6>{{localize "abfalter.failure"}}</h6>
        <div>{{localize "abfalter.psyFailLevel"}}: {{matrixResolution.failureLevel}}</div>
        <div>{{localize "abfalter.fatigue"}}: {{matrixResolution.fatigue}}</div>
    </div>
    {{else}}
    {{#if matrixResolution.chosen}}
    <div class="matrixSuccess">
        <h6> 
            {{matrixResolution.chosenTitle}}
            <a class="descToggle2" data-value="{{descToggle2}}">
                <i class="fas fa-chevron-down fa-fw"></i>
            </a>
        </h6>
        <div class="mastrixSuccessDesc"> 
            <div class="itemDescription2 {{#if descToggle2}}ItemDescClose{{/if}}">
                {{{matrixResolution.chosenDesc}}} 
            </div>
        </div>

        {{#ifEquals matrixDetails.type "shield"}}
        <div> {{localize (concat "abfalter." matrixDetails.type)}} {{localize "abfalter.info"}} </div>
        <div> {{matrixResolution.shieldInfo}} </div>
        {{/ifEquals}}

        {{#ifEquals matrixDetails.type "attack"}}
        <div> {{localize (concat "abfalter." matrixDetails.type)}} {{localize "abfalter.info"}} </div>
        <div> {{matrixResolution.attackInfo}} </div>
        {{#unless matrixResolution.rollFinished}}
        <button type="button" class="attackMatrixTargets matrixButton">
            {{localize "abfalter.selectTargets"}}
        </button>
        {{/unless}}
        {{/ifEquals}}

        {{#ifEquals matrixDetails.type "effect"}}
        <div> {{localize (concat "abfalter." matrixDetails.type)}} {{localize "abfalter.info"}} </div>
        <div> {{matrixResolution.resInfo}} </div>
        <!--
        {{#unless matrixResolution.rollFinished}}
        <button type="button" class="effectMatrixTargets matrixButton">
            {{localize "abfalter.selectTargets"}}
        </button>
        {{/unless}}
        -->
        {{/ifEquals}}
    </div>
    {{else}}
    <div class="matrixEffectChoices">
        {{#each matrixResolution.availableEffects as |effect|}}
        <div class="chatCustomRoll chatCustomTitleContainer">
            <button type="button" class="selectMatrixEffect" data-effect-key="{{effect.key}}">
                {{localize (concat "abfalter." effect.title)}} ({{effect.titleNum}})
            </button>
            <div class="chatCustomTitle">
                {{{effect.description}}}
            </div>
        </div>
        {{/each}}
    </div>
    {{/if}}
    {{/if}}
    {{/if}}
</div>