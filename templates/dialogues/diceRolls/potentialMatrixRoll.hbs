{{> "systems/abfalter/templates/dialogues/partials/customChatHeader.hbs"}}

<div class="baseAbfalterV2 defaultRollMsg itemChat">
    <div class="chatItemContent">
        <div class="chatItemHeader">
            <img src="{{matrixDetails.img}}"/>
            <div>
                <span> {{matrixDetails.name}} </span>
                <div> {{matrixDetails.tag}} </div>
            </div>
            <a class="descToggle" data-value="{{descToggle}}">
                <i class="fas fa-chevron-right fa-fw"></i>
            </a>
        </div>

        <div class="itemDescription {{#if descToggle}}ItemDescOpen{{/if}}">
            {{{matrixDetails.desc}}}
        </div>
    </div>

    {{> "systems/abfalter/templates/dialogues/partials/customDefaultRoll.hbs"}}

    {{#each rollData as |roll i|}}
    <label class="explodeButtons">
        {{#if roll.explode}}
        <button class="potentialContinuationRoll" data-roll-type="open"> {{localize "abfalter.dialogs.openRoll"}} </button>
        {{/if}}
        {{#if roll.fumble}}
        <button class="potentialContinuationRoll" data-roll-type="fumble"> {{localize "abfalter.dialogs.fumbleSeverity2"}} </button>
        {{/if}}
    </label>
    {{/each}}

    {{#if matrixDetails.resolved}}
    {{#if matrixResolution.failed}}
        <div class="matrixFailure">
            <span>Failed</span>

            <div>
                Fatigue: {{matrixResolution.fatigue}}
            </div>
        </div>
    {{else}}
        <div class="matrixEffectChoices">
        {{#each matrixResolution.availableEffects as |effect|}}
        <div class="chatCustomRoll chatCustomTitleContainer">
            <button
                type="button"
                class="selectMatrixEffect"
                data-effect-key="{{effect.key}}"
            >
                {{effect.title}} ({{effect.titleNum}})
            </button>

            <div class="chatCustomTitle">
                {{{effect.description}}}
            </div>
        </div>
        {{/each}}
        </div>
    {{/if}}
    {{/if}}

