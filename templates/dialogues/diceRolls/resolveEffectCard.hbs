<div class="abfalterChatHeader">
    <img class="abfalterChatPortrait" src="{{basicInfo.portrait}}">

    <div class="abfalterChatHeaderNames">
        <span class="abfalterChatActor">{{basicInfo.name}}</span>
        <span class="abfalterCharUser">{{basicInfo.userName}}</span>
    </div>

    <div class="abfResolutionTime"></div>
</div>

<div class="baseAbfalterV2 resolveCombatMsg">
    <div>
        <span>{{localize "abfalter.effectResults"}}</span>
    </div>

    <div class="resolveAttackContainer">
        <div class="resolveAttackData">
            <label>
                <span>{{resolveData.effectDetails.label}}</span>
            </label>

            <label>
                {{#if resolveData.effectDetails.useProj}}
                <span>
                    {{localize "abfalter.projection"}}: {{resolveData.attackerValue}} |
                </span>
                {{/if}}

                <span>
                    {{localize "abfalter.resistance"}}: {{resolveData.effectDetails.resValue}}
                </span>
            </label>

            <label>
                <span>{{localize "abfalter.resTypes"}}:</span>

                {{#each resolveData.effectDetails.resTypeList as |type|}}
                    <span>{{localize (concat "abfalter." type)}}{{#unless @last}}, {{/unless}}</span>
                {{/each}}
            </label>

            {{#if resolveData.effectDetails.useAT}}
            <label>
                <span>
                    {{localize "abfalter.armor"}}:
                    {{localize (concat "abfalter." resolveData.effectDetails.atLabel)}}
                </span>
            </label>
            {{/if}}
        </div>
    </div>

    <div>
        <div class="resolveTargetsHeader">
            <span class="resolveTargetsHeaderCenter">
                <i class="fa-solid fa-shield-halved resolveTargetsHeaderIcon"></i>
                <span class="resolveTargetsHeaderText">{{localize "abfalter.targets"}}</span>
                <i class="fas fa-caret-right resolveTargetsHeaderChevron"></i>
            </span>
        </div>

        <div class="resolveTargetsBody">
            {{#each resolveData.defenderValues as |defender key|}}
            <div class="resolveDefenderContainer" data-defender-index="{{key}}" data-defender-id="{{key}}">
                <div class="resolveDefenderTopRow">
                    <img class="resolveDefenderPortraitWrap" src="{{defender.portrait}}">
                    <div class="resolveDefenderName">{{defender.name}}</div>

                    {{#if defender.requiresResistance}}
                    <button type="button" class="resolveResistanceCheck" data-token-id="{{key}}">
                        {{localize "abfalter.rollRes"}}
                    </button>
                    {{else}}
                    <div class="openRoll">
                        {{localize "abfalter.resisted"}}
                    </div>
                    {{/if}}
                </div>

                <div class="resolveDefenderMiddle">
                    {{#if ../resolveData.effectDetails.useProj}}
                        <div class="resolveDefenderStatsRow">
                            <span class="resolveDefenderStat">
                                {{localize "abfalter.defense"}}: {{defender.defenseTotal}} |
                            </span>

                            {{#if ../resolveData.effectDetails.useAT}}
                            <span class="resolveDefenderStat">
                                {{localize "abfalter.finalAt"}}: {{defender.effectiveArmor}} | 
                            </span>
                            {{/if}}
                            
                            <span class="resolveDefenderStat">
                                {{localize "abfalter.diff"}}: {{defender.difference}}
                            </span>
                        </div>
                    {{/if}}
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>